+"""PhysicsV4 per-link angular bias torque, sampled at the Isaac physics period."""
+from __future__ import annotations
+
+import mujoco
+import numpy as np
+
+
+ANGULAR_LIMIT_VERSION = "PhysxRigidAngularBiasV1"
+MAX_ANGULAR_VELOCITY_DEG_S = 100.0
+UPDATE_PERIOD_S = 0.005
+
+
+def angular_limit_contract(update_period_s: float = UPDATE_PERIOD_S) -> dict:
+    if float(update_period_s) != UPDATE_PERIOD_S:
+        raise ValueError("PhysicsV4 angular bias update period must be 0.005 s")
+    return {
+        "version": ANGULAR_LIMIT_VERSION,
+        "max_angular_velocity_deg_s": MAX_ANGULAR_VELOCITY_DEG_S,
+        "max_angular_velocity_rad_s": float(np.deg2rad(MAX_ANGULAR_VELOCITY_DEG_S)),
+        "update_period_s": UPDATE_PERIOD_S,
+        "sampling": "pre_step_zero_order_hold",
+        "frame": "world",
+        "bodies": "all_robot_bodies_except_world",
+        "torque_rule": "-I_world@omega*(1-limit/norm(omega))/update_period_when_over_limit",
+        "reset": "clear_counter_and_held_torque_after_keyframe_reset",
+        "velocity_write": False,
+    }
+
+
+class AngularVelocityBiasLimiter:
+    """Apply the published PhysX 5.6.1 angular bias term without writing qvel.
+
+    The torque is recomputed every 5 ms and held through the MuJoCo substeps.
+    Kinematics are refreshed on shadow data so live solver buffers stay intact.
+    Call reset after resetting the associated live MjData.
+    """
+
+    def __init__(self, model: mujoco.MjModel, update_period_s: float = UPDATE_PERIOD_S) -> None:
+        angular_limit_contract(update_period_s)
+        dt = float(model.opt.timestep)
+        if not np.isfinite(dt) or dt <= 0.:
+            raise ValueError("MuJoCo physics timestep must be finite and positive")
+        self._steps = round(update_period_s / dt)
+        if self._steps < 1 or abs(self._steps * dt - update_period_s) > 1.e-12:
+            raise ValueError("Angular bias update period must be an integer multiple of MuJoCo timestep")
+        self._model = model
+        self._shadow = mujoco.MjData(model)
+        self._limit = float(np.deg2rad(MAX_ANGULAR_VELOCITY_DEG_S))
+        self._held_torque = np.zeros((model.nbody, 3), dtype=np.float64)
+        self.reset()
+
+    def reset(self) -> None:
+        self._substep = 0
+        self._held_torque.fill(0.)
+
+    def apply(self, data: mujoco.MjData) -> None:
+        if self._substep % self._steps == 0:
+            mujoco.mj_copyData(self._shadow, self._model, data)
+            mujoco.mj_forward(self._model, self._shadow)
+            # Replace only our previous contribution; preserve other external torques.
+            data.xfrc_applied[:, 3:] -= self._held_torque
+            self._held_torque.fill(0.)
+            spatial = np.zeros(6, dtype=np.float64)
+            for body_id in range(1, self._model.nbody):
+                mujoco.mj_objectVelocity(
+                    self._model, self._shadow, mujoco.mjtObj.mjOBJ_BODY, body_id, spatial, 0,
+                )
+                omega = spatial[:3]
+                speed = float(np.linalg.norm(omega))
+                if speed > self._limit:
+                    rotation = self._shadow.ximat[body_id].reshape(3, 3)
+                    inertia = rotation @ np.diag(self._model.body_inertia[body_id]) @ rotation.T
+                    self._held_torque[body_id] = -(inertia @ omega) * (1. - self._limit / speed) / UPDATE_PERIOD_S
+            data.xfrc_applied[:, 3:] += self._held_torque
+        self._substep += 1
