+from __future__ import annotations
+
+import mujoco
+import numpy as np
+import pytest
+
+from wheelleg_mujoco.angular_limit import AngularVelocityBiasLimiter, angular_limit_contract
+
+
+def _free_body():
+    model = mujoco.MjModel.from_xml_string('''<mujoco>
+      <option timestep="0.001" gravity="0 0 0"/>
+      <worldbody><body><freejoint/>
+        <inertial pos="0 0 0" mass="1" diaginertia="2 3 4"/>
+      </body></worldbody></mujoco>''')
+    return model, mujoco.MjData(model)
+
+
+def test_units_and_world_inertia_without_changing_live_state():
+    model, data = _free_body()
+    # A 90-degree world-z rotation maps local Iy=3 onto world x.
+    data.qpos[3:7] = (np.sqrt(.5), 0., 0., np.sqrt(.5))
+    data.qvel[3:6] = (0., -2., 0.)  # Free-joint angular velocity is local.
+    mujoco.mj_forward(model, data)
+    assert np.allclose(data.cvel[1, :3], (2., 0., 0.))
+    state = {name: getattr(data, name).copy() for name in ("qpos", "qvel", "qacc", "xmat", "qfrc_constraint")}
+    limiter = AngularVelocityBiasLimiter(model)
+    limiter.apply(data)
+    expected_x = -3. * (2. - np.deg2rad(100.)) / .005
+    np.testing.assert_allclose(data.xfrc_applied[1, 3:], (expected_x, 0., 0.), atol=1.e-12)
+    assert data.time == 0.
+    for name, expected in state.items():
+        np.testing.assert_array_equal(getattr(data, name), expected)
+    identity = angular_limit_contract()
+    assert identity["max_angular_velocity_deg_s"] == 100.
+    assert identity["max_angular_velocity_rad_s"] == pytest.approx(np.deg2rad(100.))
+
+
+def test_hold_five_substeps_then_release_preserving_other_torque_and_reset():
+    model, data = _free_body()
+    limiter = AngularVelocityBiasLimiter(model)
+    data.qvel[3] = 2.
+    external = np.array((7., 8., 9.))
+    data.xfrc_applied[1, 3:] = external
+    limiter.apply(data)
+    held = data.xfrc_applied.copy()
+    assert held[1, 3] < external[0]
+    data.qvel.fill(0.)
+    for _ in range(4):
+        limiter.apply(data)
+        np.testing.assert_array_equal(data.xfrc_applied, held)
+    limiter.apply(data)
+    np.testing.assert_allclose(data.xfrc_applied[1, 3:], external, atol=1.e-12)
+    mujoco.mj_resetData(model, data)
+    limiter.reset()
+    limiter.apply(data)
+    np.testing.assert_array_equal(data.xfrc_applied, np.zeros_like(data.xfrc_applied))
+
+
+def test_sub_limit_velocity_has_no_bias_and_all_links_are_considered():
+    model = mujoco.MjModel.from_xml_string('''<mujoco>
+      <option timestep="0.001" gravity="0 0 0"/>
+      <worldbody>
+        <body name="a"><freejoint/><inertial pos="0 0 0" mass="1" diaginertia="2 3 4"/></body>
+        <body name="b" pos="2 0 0"><freejoint/><inertial pos="0 0 0" mass="1" diaginertia="2 3 4"/></body>
+      </worldbody></mujoco>''')
+    data = mujoco.MjData(model)
+    data.qvel[3] = 1.
+    data.qvel[9] = 2.
+    limiter = AngularVelocityBiasLimiter(model)
+    limiter.apply(data)
+    assert np.count_nonzero(data.xfrc_applied[0]) == 0
+    assert np.count_nonzero(data.xfrc_applied[1]) == 0
+    assert data.xfrc_applied[2, 3] < 0.
+
+
+def test_reject_nonintegral_or_wrong_isaac_period():
+    model, _ = _free_body()
+    with pytest.raises(ValueError, match="PhysicsV4"):
+        AngularVelocityBiasLimiter(model, update_period_s=.001)
+    model.opt.timestep = .002
