        {
          "name": "_reward_dof_vel",
          "line": 837,
          "end_line": 839,
          "code": "    def _reward_dof_vel(self):\n        # Penalize dof velocities\n        return torch.sum(torch.square(self.dof_vel), dim=1)"
        },
        {
          "name": "_reward_dof_acc",
          "line": 841,
          "end_line": 843,
          "code": "    def _reward_dof_acc(self):\n        # Penalize dof accelerations\n        return torch.sum(torch.square((self.last_dof_vel - self.dof_vel) / self.dt), dim=1)"
        },
        {
          "name": "_reward_action_rate",
          "line": 845,
          "end_line": 847,
          "code": "    def _reward_action_rate(self):\n        # Penalize changes in actions\n        return torch.sum(torch.square(self.last_actions - self.actions), dim=1)"
        },
        {
          "name": "_reward_dof_vel_limits",
          "line": 863,
          "end_line": 866,
          "code": "    def _reward_dof_vel_limits(self):\n        # Penalize dof velocities too close to the limit\n        # clip to max error = 1 rad/s per joint to avoid huge penalties\n        return torch.sum((torch.abs(self.dof_vel) - self.dof_vel_limits*self.cfg.rewards.soft_dof_vel_limit).clip(min=0., max=1.), dim=1)"
        }
