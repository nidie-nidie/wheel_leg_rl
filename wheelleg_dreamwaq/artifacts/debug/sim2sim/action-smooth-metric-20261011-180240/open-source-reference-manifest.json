      "functions": [
        {
          "name": "_reward_dof_vel",
          "line": 1663,
          "end_line": 1667,
          "code": "    def _reward_dof_vel(self):\n        # Penalize dof velocities\n        return torch.sum(torch.square(self.dof_vel[:, :2]), dim=1) + torch.sum(\n            torch.square(self.dof_vel[:, 3:5]), dim=1\n        )"
        },
        {
          "name": "_reward_dof_acc",
          "line": 1669,
          "end_line": 1671,
          "code": "    def _reward_dof_acc(self):\n        # Penalize dof accelerations\n        return torch.sum(torch.square(self.dof_acc), dim=1)"
        },
        {
          "name": "_reward_action_rate",
          "line": 1673,
          "end_line": 1675,
          "code": "    def _reward_action_rate(self):\n        # Penalize changes in actions\n        return torch.sum(torch.square(self.last_actions[:, :, 0] - self.actions), dim=1)"
        },
        {
          "name": "_reward_action_smooth",
          "line": 1677,
          "end_line": 1693,
          "code": "    def _reward_action_smooth(self):\n        # Penalize changes in actions\n        return torch.sum(\n            torch.square(\n                self.actions[:, :2]\n                - 2 * self.last_actions[:, :2, 0]\n                + self.last_actions[:, :2, 1]\n            ),\n            dim=1,\n        ) + torch.sum(\n            torch.square(\n                self.actions[:, 3:5]\n                - 2 * self.last_actions[:, 3:5, 0]\n                + self.last_actions[:, 3:5, 1]\n            ),\n            dim=1,\n        )"
        },
        {
          "name": "_reward_dof_vel_limits",
          "line": 1728,
          "end_line": 1737,
          "code": "    def _reward_dof_vel_limits(self):\n        # Penalize dof velocities too close to the limit\n        # clip to max error = 1 rad/s per joint to avoid huge penalties\n        return torch.sum(\n            (\n                torch.abs(self.dof_vel)\n                - self.dof_vel_limits * self.cfg.rewards.soft_dof_vel_limit\n            ).clip(min=0.0, max=1.0),\n            dim=1,\n        )"
        }
      ],
      "reward_config": []
