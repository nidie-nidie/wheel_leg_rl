          "end_line": 1850,
          "code": "    def _reward_dof_vel(self):\n        # Penalize dof velocities\n        return torch.sum(torch.square(self.dof_vel[:, :2]), dim=1) + torch.sum(\n            torch.square(self.dof_vel[:, 3:5]), dim=1)"
