+        params = {
+            "effort": env.robot.root_physx_view.get_dof_max_forces(),
+            "damping": env.robot.root_physx_view.get_dof_dampings(),
+            "armature": env.robot.root_physx_view.get_dof_armatures(),
+        }
+        for name, actuator in env.robot.actuators.items():
