+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception:
+        error = traceback.format_exc()
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.with_suffix(".error.txt").write_text(error, encoding="utf-8")
+        print(error, flush=True)
