      "file": "E:\\wheel_leg_rl-main\\wheelleg_dreamwaq\\artifacts\\debug\\sim2sim\\university-wheelleg-review-20261013-v1\\clearlab-sustech__Wheel-Legged-Gym\\wheel_legged_gym\\envs\\base\\legged_robot.py",
      "function": "_reward_dof_vel",
      "start": 1663,
      "end": 1667,
      "source": "def _reward_dof_vel(self):\n        # Penalize dof velocities\n        return torch.sum(torch.square(self.dof_vel[:, :2]), dim=1) + torch.sum(\n            torch.square(self.dof_vel[:, 3:5]), dim=1\n        )"
    },
    {
      "file": "E:\\wheel_leg_rl-main\\wheelleg_dreamwaq\\artifacts\\debug\\sim2sim\\university-wheelleg-review-20261013-v1\\clearlab-sustech__Wheel-Legged-Gym\\wheel_legged_gym\\envs\\base\\legged_robot.py",
      "function": "_reward_dof_acc",
      "start": 1669,
      "end": 1671,
      "source": "def _reward_dof_acc(self):\n        # Penalize dof accelerations\n        return torch.sum(torch.square(self.dof_acc), dim=1)"
    },
    {
      "file": "E:\\wheel_leg_rl-main\\wheelleg_dreamwaq\\artifacts\\debug\\sim2sim\\university-wheelleg-review-20261013-v1\\clearlab-sustech__Wheel-Legged-Gym\\wheel_legged_gym\\envs\\base\\legged_robot.py",
      "function": "_reward_action_rate",
      "start": 1673,
      "end": 1675,
      "source": "def _reward_action_rate(self):\n        # Penalize changes in actions\n        return torch.sum(torch.square(self.last_actions[:, :, 0] - self.actions), dim=1)"
    },
    {
      "file": "E:\\wheel_leg_rl-main\\wheelleg_dreamwaq\\artifacts\\debug\\sim2sim\\university-wheelleg-review-20261013-v1\\clearlab-sustech__Wheel-Legged-Gym\\wheel_legged_gym\\envs\\base\\legged_robot.py",
      "function": "_reward_action_smooth",
      "start": 1677,
      "end": 1693,
      "source": "def _reward_action_smooth(self):\n        # Penalize changes in actions\n        return torch.sum(\n            torch.square(\n                self.actions[:, :2]\n                - 2 * self.last_actions[:, :2, 0]\n                + self.last_actions[:, :2, 1]\n            ),\n            dim=1,\n        ) + torch.sum(\n            torch.square(\n                self.actions[:, 3:5]\n                - 2 * self.last_actions[:, 3:5, 0]\n                + self.last_actions[:, 3:5, 1]\n            ),\n            dim=1,\n        )"
    }
