{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wheel-leg-motor-pace.local/schemas/actuator-model-v1.json",
  "title": "Wheel-leg six-channel actuator model",
  "type": "object",
  "required": [
    "schema_version",
    "model_maturity",
    "sample_period_s",
    "canonical_order",
    "motor_order_version",
    "motor_manifest_hash",
    "source_session",
    "fit_backend",
    "motors",
    "aggregate_metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "wheel_leg_motor_pace/actuator_model/v1"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "model_maturity": {
      "enum": [
        "provisional",
        "final"
      ]
    },
    "sample_period_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "canonical_order": {
      "const": [
        "L_front",
        "L_rear",
        "R_rear",
        "R_front",
        "L_wheel",
        "R_wheel"
      ]
    },
    "motor_order_version": {
      "const": 1
    },
    "motor_manifest_hash": {
      "type": "integer",
      "minimum": 0
    },
    "source_session": {
      "type": "object",
      "required": [
        "session_type",
        "session_id",
        "experiment_config_hash",
        "firmware_build_id",
        "robot_variant",
        "sample_rate_hz",
        "footer_valid",
        "decode_issue_counts",
        "protocol_version",
        "quality_passed",
        "raw_sha256",
        "calibration_sha256",
        "metadata_sha256"
      ],
      "properties": {
        "protocol_version": {
          "const": 2
        },
        "quality_passed": {
          "const": true
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calibration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "footer_valid": {
          "const": true
        },
        "decode_issue_counts": {
          "type": "object",
          "maxProperties": 0
        },
        "firmware_binary_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "fixture": {
          "type": "string"
        }
      }
    },
    "fit_backend": {
      "type": "object"
    },
    "motors": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/motor"
      }
    },
    "aggregate_metrics": {
      "type": "object"
    }
  },
  "definitions": {
    "metricSet": {
      "type": "object",
      "required": [
        "sample_count",
        "rmse",
        "p95_abs_error",
        "max_abs_error",
        "estimated_delay_steps",
        "delay_error_steps",
        "saturation_rate"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "rmse": {
          "type": "number",
          "minimum": 0
        },
        "p95_abs_error": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_error": {
          "type": "number",
          "minimum": 0
        },
        "estimated_delay_steps": {
          "type": "integer",
          "minimum": 0
        },
        "delay_error_steps": {
          "type": "integer"
        },
        "saturation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "motor": {
      "type": "object",
      "required": [
        "canonical_index",
        "name",
        "motor_type",
        "actuator_family",
        "mujoco_joint",
        "isaac_joint",
        "position_sign",
        "velocity_sign",
        "torque_sign",
        "position_zero_rad",
        "gear_ratio",
        "model",
        "fit",
        "validation"
      ],
      "properties": {
        "canonical_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "name": {
          "type": "string"
        },
        "motor_type": {
          "enum": [
            "DM8009",
            "LK9025"
          ]
        },
        "actuator_family": {
          "enum": [
            "leg_dm",
            "wheel_lk"
          ]
        },
        "mujoco_joint": {
          "type": "string"
        },
        "isaac_joint": {
          "type": "string"
        },
        "position_sign": {
          "enum": [
            -1,
            1
          ]
        },
        "velocity_sign": {
          "enum": [
            -1,
            1
          ]
        },
        "torque_sign": {
          "enum": [
            -1,
            1
          ]
        },
        "position_zero_rad": {
          "type": "number"
        },
        "gear_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "model": {
          "oneOf": [
            {
              "$ref": "#/definitions/dmModel"
            },
            {
              "$ref": "#/definitions/lkModel"
            }
          ]
        },
        "fit": {
          "type": "object"
        },
        "validation": {
          "type": "object"
        },
        "calibration_verified": {
          "type": "boolean"
        }
      }
    },
    "controller": {
      "type": "object",
      "required": [
        "kp",
        "kd",
        "dq_des_rad_s",
        "torque_feedforward_nm"
      ],
      "properties": {
        "kp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "kd": {
          "type": "number",
          "minimum": 0
        },
        "dq_des_rad_s": {
          "type": "number"
        },
        "torque_feedforward_nm": {
          "type": "number"
        }
      }
    },
    "dmModel": {
      "type": "object",
      "required": [
        "type",
        "armature",
        "viscous_friction",
        "static_friction",
        "dynamic_friction",
        "encoder_bias_rad",
        "delay_steps",
        "delay_s",
        "identification_sample_period_s",
        "delay_semantics",
        "controller",
        "effort_limit_nm"
      ],
      "properties": {
        "armature": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "viscous_friction": {
          "type": "number",
          "minimum": 0
        },
        "static_friction": {
          "type": "number",
          "minimum": 0
        },
        "dynamic_friction": {
          "type": "number",
          "minimum": 0
        },
        "delay_steps": {
          "type": "integer",
          "minimum": 0
        },
        "delay_s": {
          "type": "number",
          "minimum": 0
        },
        "identification_sample_period_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "friction_transition_velocity_rad_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "type": {
          "const": "pace_dm_pd_v1"
        },
        "encoder_bias_rad": {
          "type": "number"
        },
        "delay_semantics": {
          "const": "target_before_pd"
        },
        "controller": {
          "$ref": "#/definitions/controller"
        },
        "effort_limit_nm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "parameter_semantics": {
          "type": "string"
        }
      }
    },
    "lkTorque": {
      "type": "object",
      "required": [
        "armature",
        "viscous_friction",
        "static_friction",
        "dynamic_friction",
        "delay_steps",
        "delay_s",
        "identification_sample_period_s",
        "delay_semantics"
      ],
      "properties": {
        "armature": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "viscous_friction": {
          "type": "number",
          "minimum": 0
        },
        "static_friction": {
          "type": "number",
          "minimum": 0
        },
        "dynamic_friction": {
          "type": "number",
          "minimum": 0
        },
        "delay_steps": {
          "type": "integer",
          "minimum": 0
        },
        "delay_s": {
          "type": "number",
          "minimum": 0
        },
        "identification_sample_period_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "friction_transition_velocity_rad_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "delay_semantics": {
          "const": "command_before_response"
        }
      }
    },
    "lkVelocity": {
      "type": "object",
      "required": [
        "command_gain",
        "time_constant_s",
        "delay_steps",
        "delay_s",
        "identification_sample_period_s",
        "delay_semantics"
      ],
      "properties": {
        "command_gain": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "time_constant_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "delay_steps": {
          "type": "integer",
          "minimum": 0
        },
        "delay_s": {
          "type": "number",
          "minimum": 0
        },
        "identification_sample_period_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "delay_semantics": {
          "const": "command_before_response"
        }
      }
    },
    "lkModel": {
      "type": "object",
      "required": [
        "type",
        "torque_mode",
        "velocity_mode",
        "effort_limit_nm"
      ],
      "properties": {
        "type": {
          "const": "lk9025_dual_mode_v1"
        },
        "torque_mode": {
          "$ref": "#/definitions/lkTorque"
        },
        "velocity_mode": {
          "$ref": "#/definitions/lkVelocity"
        },
        "effort_limit_nm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "parameter_semantics": {
          "type": "string"
        }
      }
    }
  }
}
